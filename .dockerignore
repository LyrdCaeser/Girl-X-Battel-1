# GXB 3 production ships VI / EN / zh-CN only. These archived localization
# tables are not used by the current server/runtime and only inflate context.
runtime/lua/data/tables/de_de/
runtime/lua/data/tables/fr_fr/
runtime/lua/data/tables/ja_jp/
runtime/lua/data/tables/ko_kr/
runtime/lua/data/tables/zh_tw/

