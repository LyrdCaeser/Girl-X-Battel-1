# GXB 3 production environment example
# Copy values into your host's secret/environment manager. Do not commit real secrets.

GXB3_PRODUCTION=1
GXB3_HOST=0.0.0.0
PORT=9080
GXB3_PUBLIC_ORIGIN=https://game.example.com

# Generate a random secret >= 24 characters. Never reuse the old development key.
GXB3_ADMIN_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_24_CHARS

# PostgreSQL is mandatory when GXB3_PRODUCTION=1.
GXB3_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
GXB3_DB_POOL_MIN=1
GXB3_DB_POOL_MAX=12

# Enable only when requests reach GXB3 through a trusted reverse proxy.
# This permits X-Forwarded-For / X-Forwarded-Proto to be used.
GXB3_TRUST_PROXY=1
