  "text": {
    "ACTIVITY_BLIND_BOX_TEXT01": "Số lượng: {1}",
    "ACTIVITY_BLIND_BOX_TEXT02": "Mở 1 Hộp",
    "ACTIVITY_BLIND_BOX_TEXT03": "Mở 5 Hộp",
    "ACTIVITY_BLIND_BOX_TEXT04": "Chọn {2} phần thưởng ở bậc {1}",
    "ACTIVITY_BLIND_BOX_TEXT05": "Phần thưởng tự chọn bậc {2} ở vòng {1}",
    "ACTIVITY_BLIND_BOX_TEXT06": "Hãy chọn phần thưởng mong muốn",
    "ACTIVITY_BLIND_BOX_TEXT07": "Sau khi nhận được một phần thưởng, bạn không thể thay đổi lựa chọn của vòng này. Tiếp tục?",
    "ACTIVITY_BLIND_BOX_TEXT08": "Vòng 2 có phần thưởng tốt hơn. Chuyển sang vòng tiếp theo sẽ không thể nhận những phần thưởng còn lại của vòng hiện tại. Tiếp tục?",
    "ACTIVITY_BLIND_BOX_MISSION": "Nhận {1} EXP VIP",
    "ACTIVITY_BLIND_BOX_HELP": "1. Chọn phần thưởng theo 4 bậc.|2. Sau khi chọn đủ các phần thưởng, dùng Vé Hộp Mù để mở hộp ngẫu nhiên.|3. Có thể thay đổi phần thưởng đã chọn trước khi nhận bất kỳ phần thưởng nào.|4. Chọn 3 phần thưởng bậc 1, 3 phần thưởng bậc 2, 1 phần thưởng bậc 3 và 1 phần thưởng bậc 4.|5. Mỗi vòng có phần thưởng lớn. Nhận phần thưởng lớn để mở vòng tiếp theo.|6. Mỗi vòng bảo đảm nhận giải lớn trong tối đa 30 lượt mở.|7. Khi sự kiện kết thúc, mỗi Vé còn lại được đổi thành 500.000 Vàng và gửi qua Thư.|8. Nhận Vé từ sự kiện thưởng Hộp Mù và quà nạp.",
    "ACTIVITY_BLIND_BOX_TITLE": "Cơn Sốt Hộp Mù",
    "ACTIVITY_BLIND_BOX_TEXT09": "Vòng {1} - Phần Thưởng Lớn",
    "ACTIVITY_BLIND_BOX_TEXT10": "Bạn cần chọn thêm phần thưởng!",
    "ACTIVITY_BLIND_BOX_TEXT11": "Chúc mừng! Bạn đã nhận giải lớn của vòng 2 và vẫn có thể nhận các phần thưởng khác trong vòng này!"
  },
