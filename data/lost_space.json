  "event_text": {
    "1": {
      "name": "Portal",
      "icon": "activity_lost_space_icon_xyg_90",
      "desc": "You will leave your current Space Zone and enter a new Space Zone by tapping on a portal. You will also obtain the chest reward for the current Space Zone."
    },
    "2": {
      "name": "Supply Stash",
      "icon": "activity_lost_space_icon_bjd_90",
      "desc": "A supply hideout located in the Space Zones. You will obtain huge rewards for entering a Supply Stash. But you will need enough Supply Coordinates to get enough information about its location."
    },
    "3": {
      "name": "Supply Coordinate",
      "icon": "activity_lost_space_icon_bjz_1_90",
      "desc": "Records the information of the Supply Stash location. You will locate the Supply Stash after collecting 3 Supply Coordinates."
    },
    "4": {
      "name": "Hologram Machine",
      "icon": "activity_lost_space_icon_xj",
      "desc": "Valuable records left behind by the predecessors. It will show you the location of a high-value reward in the current Space Zone once triggered. Can only be used in the Space Zone where it is found."
    },
    "5": {
      "name": "Copier",
      "icon": "activity_lost_space_icon_double_90",
      "desc": "A mysterious device that can replicate an item. Once obtained the amount of rewards you find in the next move will be doubled. (You can enter the next Space Zone with this effect triggered) (Double chance won't be consumed upon triggering a special event)"
    },
    "6": {
      "name": "Laser Energy",
      "icon": "activity_lost_space_icon_nl",
      "desc": "The energy required to activate the laser device. The laser device can be used to trigger powerful skills after it receives enough energy."
    }
  },
  "skill_text": {
    "1": {
      "name": "Sweep Laser",
      "icon": "activity_lost_space_icon_skill2",
      "desc": "Guide the Laser to explore the blocks of area in the same row as the last block explored."
    },
    "2": {
      "name": "Cross Laser",
      "icon": "activity_lost_space_icon_skill1",
      "desc": "Guide the Laser to explore (maximum) 8 blocks next to the last explored block (top bottom left and right 2 each)."
    },
    "3": {
      "name": "Charged Laser",
      "icon": "activity_lost_space_icon_skill3",
      "desc": "Guide the Laser to explore (maximum) 6 blocks next to the last explored block (top and bottom 3 each). The amount of laser energies required to trigger this skill will be reduced by 6 each time the skill is triggered (maximum by 18). ({1} reduction(s) made)"
    },
    "4": {
      "name": "Circle Laser",
      "icon": "activity_lost_space_icon_skill4",
      "desc": "Guide the Laser to explore the blocks of area neighboring the last block explored."
    },
    "5": {
      "name": "Unstable Laser",
      "icon": "activity_lost_space_icon_skill5",
      "desc": "Guide the Laser to explore 5 random blocks of area. (Unexplored area will be explored first)"
    },
    "6": {
      "name": "Adaptive Laser",
      "icon": "activity_lost_space_icon_skill6",
      "desc": "Guide the Laser to explore 2 blocks next to the last explored block (top and bottom). The exploration range will be increased by 1 block of area (1 more block for top or bottom by turns the exploration range on top will be increased first) each time the skill is triggered. (maximum by 4 blocks of area) ({1} block(s) increased)"
    }
  },
