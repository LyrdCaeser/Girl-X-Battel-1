68,"stage_belong":5,"type":5,"id":46,"boss_id":2,"offsetX":103},{"offsetY":612,"stage_belong":6,"type":0,"id":47,"boss_id":2,"offsetX":174.5},{"offsetY":597,"stage_belong":6,"type":0,"id":48,"boss_id":2,"offsetX":228.5},{"offsetY":590,"stage_belong":6,"type":0,"id":49,"boss_id":2,"offsetX":282.5},{"offsetY":503,"stage_belong":6,"type":6,"id":50,"boss_id":2,"offsetX":320},{"offsetY":574,"stage_belong":7,"type":0,"id":51,"boss_id":2,"offsetX":395.5},{"offsetY":572,"stage_belong":7,"type":0,"id":52,"boss_id":2,"offsetX":453.5},{"offsetY":567,"stage_belong":7,"type":0,"id":53,"boss_id":2,"offsetX":511.5},{"offsetY":480,"stage_belong":7,"type":7,"id":54,"boss_id":2,"offsetX":553},{"offsetY":519,"stage_belong":8,"type":0,"id":55,"boss_id":2,"offsetX":526.5},{"offsetY":512,"stage_belong":8,"type":0,"id":56,"boss_id":2,"offsetX":461.5},{"offsetY":438,"stage_belong":8,"type":8,"id":57,"boss_id":2,"offsetX":385},{"offsetY":502,"stage_belong":9,"type":0,"id":58,"boss_id":2,"offsetX":346.5}],"buff_text":{"1":{"name":"Xuyên Tâm","desc":"Khi bắt đầu trận, toàn bộ địch chịu một hiệu ứng sát thương theo thời gian ngẫu nhiên trong 3 lượt. Địch đang Chảy Máu, Trúng Độc hoặc Thiêu Đốt chịu thêm 25% sát thương khác."},"2":{"name":"Khơi Dậy Tiềm Năng","desc":"Tăng 25% Chí Mạng và 25% Sát Thương Chí Mạng cho toàn bộ Nữ Thần."},"3":{"name":"Tu La Đạo","desc":"Khi chịu sát thương, Nữ Thần có 75% xác suất phản đòn gây sát thương bằng 100% Tấn Công và chắc chắn trúng."},"4":{"name":"Kiếm Lão Luyện","desc":"Mỗi trận thắng tăng 5% Tấn Công cho toàn bộ Nữ Thần, có thể cộng dồn."},"5":{"name":"THÁNH QUANG!","desc":"Đầu mỗi trận, hồi cho Nữ Thần có HP thấp nhất 40% HP tối đa của bản thân."},"6":{"name":"Ánh Sáng Chia Sẻ","desc":"Đầu mỗi trận, hồi cho 2 Nữ Thần có HP thấp nhất 20% HP tối đa của bản thân."},"7":{"name":"Sinh Trưởng Mạnh","desc":"Tăng 20% HP tối đa cho các Nữ Thần."},"8":{"name":"Tận Dụng Chiến Thắng","desc":"Sau khi một địch bị hạ, tăng 100% Sát Thương Kỹ Năng cho toàn đội; Nữ Thần kết liễu hồi 100 Năng Lượng."},"9":{"name":"Song Kiếm","desc":"Tăng 100% sát thương Đánh Thường; mỗi Đánh Thường của đồng minh có 50% xác suất tung thêm một đòn."},"10":{"name":"Bão Mây","desc":"Tăng 25% lượng hồi máu phe ta, giảm 75% lượng hồi máu phe địch. Mỗi khi Nữ Thần được hồi máu, địch có HP cao nhất nhận sát thương bằng 5% HP tối đa của Nữ Thần vừa được hồi (tối đa 80.000), chắc chắn trúng."},"11":{"name":"Tập Trung Hỏa Lực","desc":"Đầu mỗi trận, một địch ngẫu nhiên chịu thêm 60% sát thương trong 4 lượt. Khi địch đó bị hạ, hiệu ứng chuyển sang địch khác, không làm mới thời hạn."},"12":{"name":"Khắc Chế Hệ","desc":"Gây thêm 60% sát thương lên Nữ Thần thuộc hệ bị hệ của mình khắc chế."},"13":{"name":"Suối Sinh Mệnh","desc":"Hồi 50% HP tối đa cho 3 Nữ Thần có HP thấp nhất."},"14":{"name":"Tiếng Hát Hồi Sinh","desc":"Hồi sinh một Nữ Thần ngẫu nhiên đã tử trận và hồi 100% HP tối đa; nếu không có ai tử trận, hồi đầy HP cho Nữ Thần có HP thấp nhất."},"15":{"name":"Miễn Nhiễm","desc":"Tăng 40% Kháng Khống Chế cho các Nữ Thần."},"16":{"name":"Lá Chắn","desc":"Tăng 30% Tỷ Lệ Đỡ Đòn cho các Nữ Thần."},"17":{"name":"Chiến Hạm Tiên Phong","desc":"Tăng 25% Giáp cho Nữ Thần hàng trước; tăng lượng hồi máu nhận được lên 200%."},"18":{"name":"Đòn Đánh Chính Xác","desc":"Tăng 60% Chính Xác và 30% Xuyên Giáp cho Nữ Thần hàng sau."},"19":{"name":"Xích Hư Không","desc":"Tăng 60% Tỷ Lệ Khống Chế cho các Nữ Thần."},"20":{"name":"Thành Lũy","desc":"Giảm 20% sát thương theo thời gian mà Nữ Thần phải chịu."},"21":{"name":"Đa Trùng Kỹ Năng","desc":"Nữ Thần có 25% xác suất kích hoạt lại Kỹ Năng Chủ Động."},"22":{"name":"Nghi Thức Hắc Ám","desc":"Đầu trận, Nữ Thần có 90% HP và 200 Năng Lượng."},"23":{"name":"Khát Máu","desc":"Hồi máu cho Nữ Thần bằng 15% sát thương từ các đòn Tấn Công đã gây ra."},"24":{"name":"Thánh Hộ","desc":"Giúp Nữ Thần miễn nhiễm một lần sát thương chí tử (có thể cộng dồn với hiệu ứng cùng loại từ Cổ Vật)."}},"text":{"NEW_TRIAL_HELP":"1. Thánh Địa có 9 ải gồm: Thường, Tinh Anh, Cửa Hàng và Trùm.\\n2. Vượt ải thường nhận thưởng; ải Tinh Anh được chọn hiệu ứng tăng cường; Cửa Hàng bán vật phẩm; Trùm hồi sinh một lần và mạnh hơn, thưởng theo sát thương gây ra.\\n3. Nữ Thần giữ nguyên HP giữa các ải, HP bằng 0 không thể chiến đấu trong lượt này.\\n4. Mỗi ngày chỉ có một lượt đặt lại tiến độ, không cộng dồn. Hoạt động tính theo tuần.","NEW_TRIAL_OUT_SHOP_TIP":"Cơ hội chỉ có một lần!","NEW_TRIAL_SHOP_TIP":"Vật phẩm hữu ích đang được bán!","NEW_TRIAL_RESET_TIPS":"Mỗi ngày có một lượt đặt lại tiến độ, bắt đầu lại từ ải 1; lượt đặt lại không cộng dồn.","NEW_TRIAL_RESET_TIMES":"Lượt đặt lại còn: {1}","NEW_TRIAL_CAN_NOT_RESET":"Không thể đặt lại","NEW_TRIAL_BLESS_TIPS":"Hiệu ứng đã nhận trong lượt này","NEW_TRIAL_LEVEL_TITLE":"Ải {1}","NEW_TRIAL_START":"Bắt đầu","NEW_TRIAL_NO_BLESS_TIPS":"Chưa có hiệu ứng","NEW_TRIAL_MON":"Hoàn thành nhiệm vụ sự kiện để nhận phần thưởng qua thư.","NEW_TRIAL_BUFF_TIPS":"Hãy chọn một hiệu ứng tăng cường!","NEW_TRIAL_RESET_TEXT01":"Thánh Địa đang cập nhật","NEW_TRIAL_RESET_TEXT02":"Thánh Địa sẽ cập nhật sau: {1}","NEW_TRIAL_VOLCAN_SECRET":"Thánh Địa Núi Lửa","NEW_TRIAL_SEA_SECRET":"Thánh Địa Biển Sâu","NEW_TRIAL_MAIN_WINDOW_TEXT01":"{1} đã mở","NEW_TRIAL_MAIN_WINDOW_TEXT02":"Thánh Địa\\nVượt Ải"}}