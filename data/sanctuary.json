68,"stage_belong":5,"type":5,"id":46,"boss_id":2,"offsetX":103},{"offsetY":612,"stage_belong":6,"type":0,"id":47,"boss_id":2,"offsetX":174.5},{"offsetY":597,"stage_belong":6,"type":0,"id":48,"boss_id":2,"offsetX":228.5},{"offsetY":590,"stage_belong":6,"type":0,"id":49,"boss_id":2,"offsetX":282.5},{"offsetY":503,"stage_belong":6,"type":6,"id":50,"boss_id":2,"offsetX":320},{"offsetY":574,"stage_belong":7,"type":0,"id":51,"boss_id":2,"offsetX":395.5},{"offsetY":572,"stage_belong":7,"type":0,"id":52,"boss_id":2,"offsetX":453.5},{"offsetY":567,"stage_belong":7,"type":0,"id":53,"boss_id":2,"offsetX":511.5},{"offsetY":480,"stage_belong":7,"type":7,"id":54,"boss_id":2,"offsetX":553},{"offsetY":519,"stage_belong":8,"type":0,"id":55,"boss_id":2,"offsetX":526.5},{"offsetY":512,"stage_belong":8,"type":0,"id":56,"boss_id":2,"offsetX":461.5},{"offsetY":438,"stage_belong":8,"type":8,"id":57,"boss_id":2,"offsetX":385},{"offsetY":502,"stage_belong":9,"type":0,"id":58,"boss_id":2,"offsetX":346.5}],"buff_text":{"1":{"name":"Heart Drilling","desc":"When battle starts all enemies receive random DoT lasting for 3 rounds. During the rounds when the enemies are affected by DoT (Bleeding & Poisoning & Burning) other damage taken by the enemies increases by 25%."},"2":{"name":"Potency Evocation","desc":"Increase Crit by 25% Crit Damage by 25% to all your Girls."},"3":{"name":"Way of Shura","desc":"When a Girl takes damage she has 75% chance to counterattack dealing (100% of Attack) Damage must hit."},"4":{"name":"Veteran's Sword","desc":"Increase your Girls' Attack by 5% for each battle won can stack."},"5":{"name":"HOLY LIGHT!","desc":"Heals 1 Girl in your team with the lowest HP by 40% of her Maximum HP at the start of each battle."},"6":{"name":"Shared Light","desc":"Heals 2 Girls in your team with the lowest HP by 20% of their maximum HP at the start of each battle."},"7":{"name":"Overgrowth","desc":"Increase your girls' Maximum Hp by 20%."},"8":{"name":"Complete Exploitation","desc":"After an enemy is defeated increase the Skill Damage of all your Girls by 100% the Girl who defeats the enemy will also recover her Energy by 100."},"9":{"name":"Dual Blade","desc":"Increase the damage of your Girls' Basic Attacks by 100%; Whenever an ally performs a Basic Attack there is 50% chance to perform an additional Basic Attack."},"10":{"name":"Cloudy Storm","desc":"Allies' HP healing amount will be increased by 25%. All enemies' HP healing amount will be decreased by 75%. Whenever a girl is healed the enemy with the highest HP will take damage(5% of the Max HP of the girl who was healed) (no more than 80000) must hit."},"11":{"name":"Focus Fire","desc":"Increase the damage a random enemy takes by 60% for 4 rounds at the start of each battle. The effect will be transferred to a new bearer (enemy) after the current owner is defeated (but its duration won't be refreshed)"},"12":{"name":"Weaken Hit","desc":"Deal 60% more Damage when fighting against Girls in the Faction they are strong against due to Faction Rivalry."},"13":{"name":"Fountain of Life","desc":"Heal 50% of Maximum HP for the 3 Girls with the lowest HP"},"14":{"name":"Healing Voice","desc":"Revive 1 random defeated Girl and Heal her by 100% of her Maximum HP; If there's no defeated Girl in your team the Girl with the lowest HP will be healed by 100% of her Maximum HP."},"15":{"name":"Immunity","desc":"Increase your girls' Control Immune by 40%."},"16":{"name":"Shields Up","desc":"Increase your Girls' Block rate by 30%."},"17":{"name":"Dreadnought","desc":"Increase the Armor of Girls in Front-line by 25% and allows them to receive 200% Healing amount when healed."},"18":{"name":"Precise Hit","desc":"Increase the Precision by 60% and Armor Break by 30% for the Girls in Backline."},"19":{"name":"Void Chain","desc":"Increase your Girls' Control Rate by 60%."},"20":{"name":"Rampart","desc":"Your Girls will take 20% less damage from DoT damages"},"21":{"name":"Multicast","desc":"Your girls has a 25% chance to trigger their Active Skills again。"},"22":{"name":"Evil Ritual","desc":"When battle starts your girls have 90% HP and 200 Energy."},"23":{"name":"Blood Thirst","desc":"Heals your Girls for 15% of attack damage they dealt。"},"24":{"name":"Holy Protection","desc":"Allows your girls to immune from a lethal damage (can stack with the same type of effect girls get from antiques)"}},"text":{"NEW_TRIAL_HELP":"1. The event has 9 stages the stages are separated into Normal Elite Store and Boss:\nNormal: You will get rewards for passing the stage.\nElite: You will be able to choose a buff to boost you in the rest of the stages and get rewards for passing the stage.\nStore: You will not fight in this stage and will be able to purchase some merchandise the stage provides.\nBoss: The enemy in the stage will not be truly defeated. It will revive once after getting defeated in battle and become stronger. The rewards you can get from the stage is based on the damage you dealt to the enemy.\n2. You will get Chaos Crystals for passing the stages to spin the Wheels of Fortune in the event to get additional rewards.\n3. The event will last for a week and you will get 1 Reset Chance at 0:00(UTC/GMT 0) during the event to reset your progress of stages. And Reset Chance will not stack.","NEW_TRIAL_OUT_SHOP_TIP":"It's Now or Never~","NEW_TRIAL_SHOP_TIP":"Useful items on sale~","NEW_TRIAL_RESET_TIPS":"Each day starting from 0:00(UTC 0) you will have a chance to reset your progress. You will return to stage 1 and can challenge again. The Reset Chance you get will not stack","NEW_TRIAL_RESET_TIMES":"Reset available：{1}","NEW_TRIAL_CAN_NOT_RESET":"Cannot Reset","NEW_TRIAL_BLESS_TIPS":"Blessings you have acquired this round","NEW_TRIAL_LEVEL_TITLE":"Stage {1}","NEW_TRIAL_START":"Start","NEW_TRIAL_NO_BLESS_TIPS":"No Blessings","NEW_TRIAL_MON":"The event will be refreshed every 30 days complete the following tasks and your reward will be sent via Mail!","NEW_TRIAL_BUFF_TIPS":"Please choose a blessing!","NEW_TRIAL_RESET_TEXT01":"Sanctuary is updating","NEW_TRIAL_RESET_TEXT02":"Sanctuary updating available in: [c][b1ff00]{1}[-][/c]","NEW_TRIAL_VOLCAN_SECRET":"Volcano Sanctum","NEW_TRIAL_SEA_SECRET":"Deep Sea Sanctum","NEW_TRIAL_MAIN_WINDOW_TEXT01":"{1} is available","NEW_TRIAL_MAIN_WINDOW_TEXT02":"Sanctuary\nPass"}}